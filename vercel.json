{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/mockup.js": {
      "maxDuration": 120
    }
  },
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "admin.makemetime.com" }],
      "dest": "/admin.html"
    }
  ]
}
