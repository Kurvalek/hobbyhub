# ── Supabase (accounts, saved designs, order queue) ─────────────────────────
# All three come from the Supabase dashboard: Project Settings → API Keys.
# Set them in Vercel (Project → Settings → Environment Variables) for Production,
# Preview, and Development, and in a local .env for `vercel dev`.
# Full walkthrough — including the email-template edit that makes the 6-digit code
# work, and the custom SMTP without which only your own org can sign in — is in
# SUPABASE_SETUP.md.

# "Project URL", e.g. https://abcdefghijklmno.supabase.co  (no trailing slash)
SUPABASE_URL=

# Publishable key (sb_publishable_…). Client-safe: the same value is pasted into
# index.html, because Row Level Security is what actually restricts it.
# The legacy "anon public" JWT still works under SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…). SERVER ONLY. It bypasses Row Level Security
# completely, so it must never be committed and never reach the browser. Used by
# the Shopify webhook, the admin dashboard, and the by-id design read that
# fulfillment depends on.
# The legacy "service_role" JWT still works under SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# CORS: origin allowed to call these endpoints from the browser.
# Defaults to "*" in code if unset — tighten this once the frontend's real origin is known.
ALLOWED_ORIGIN=*

# Max allowed size (in bytes) of a design's `data` payload.
MAX_DESIGN_BYTES=262144

# ── Fulfillment / admin ─────────────────────────────────────────────────────
# Shopify webhook signing secret. For app-created webhooks this is the app's API
# secret; for admin-created webhooks it's shown under Settings → Notifications.
# Used to verify orders/create webhooks in api/webhooks/order.js.
SHOPIFY_WEBHOOK_SECRET=

# Bearer token that unlocks the admin dashboard (admin.html) and /api/admin/*.
# Generate a long random value, e.g.  openssl rand -base64 32
ADMIN_TOKEN=

# BOM tuning (optional — sensible defaults in api/_lib/bom.js).
# Stitches a single DMC skein covers at 14ct; lower = more skeins per kit.
STITCHES_PER_SKEIN=1500
# Inches of Aida margin added per side around the finished stitch area.
AIDA_MARGIN_IN=3
# Punch needle loops a single tapestry wool skein covers. Far fewer than
# STITCHES_PER_SKEIN — a loop eats much more yarn than a cross stitch does.
LOOPS_PER_SKEIN=350
# Inches of monk's cloth margin per side. Wider than Aida because the gripper
# frame itself claims several inches.
MONKS_CLOTH_MARGIN_IN=4

# ── Finished-product previews (optional) ────────────────────────────────────
# Powers the "See it finished" preview on the kit review page: the design is sent
# to an image model as a reference and comes back as a photo of the made-up piece.
# Leave OPENAI_API_KEY unset and the preview is left off the page entirely —
# nothing else changes, and no other feature depends on it.
#
# Two things to know before setting this:
#  1. GPT Image models require API Organization Verification on your OpenAI
#     developer console. Without it the call fails with a permissions error.
#  2. Every press of "See it finished" is a paid image generation (roughly a few
#     cents at the default quality). It's a button rather than automatic for that
#     reason, and each result is cached for the visitor's session.
OPENAI_API_KEY=

# Image model. gpt-image-2 is current; image models turn over quickly, so this is
# overridable without a code change.
MOCKUP_MODEL=gpt-image-2
# low | medium | high. "medium" is plenty for a preview a few hundred pixels wide;
# "high" roughly triples the cost per image.
MOCKUP_QUALITY=medium
# Output size. Square is the fastest for the model to produce.
MOCKUP_SIZE=1024x1024
# Largest reference image the endpoint will accept, in bytes. The studio sends a
# 1024px PNG of the design, well under this.
MAX_MOCKUP_IMAGE_BYTES=4194304

# PDF generation (chart/template + instruction sheets via headless Chrome).
# On Vercel this uses the bundled @sparticuz/chromium automatically — no config.
# For LOCAL `vercel dev`, point this at your installed Chrome/Chromium so PDFs
# can render (auto-detected on macOS if left blank). Example:
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE_PATH=
