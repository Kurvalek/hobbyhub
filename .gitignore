# Ruby Star fabric "ruler" reference shots are not used by the app — keep them
# on disk but out of the repo (see assets/fabrics-manifest.js).
assets/fabrics/**/[Rr]uler/
assets/fabrics/**/ruler (new colors)/
assets/fabrics/**/*.zip

# Cross-stitch template source images are build-time inputs only — the app ships
# the baked data (assets/stitch-templates-data.js). Regenerate with
# tools/gen-stitch-templates.mjs. Keep on disk, out of the repo/deploy.
assets/stitch-templates/

# Design handoff exports — reference only, not part of the app.
design updates/

# Scratch scripts and their output. The _check-* scripts already committed stay
# tracked; add a new one with `git add -f` if it's worth keeping.
tools/_*

